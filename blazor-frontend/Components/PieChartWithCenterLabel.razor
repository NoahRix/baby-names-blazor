@inject ThemeState ThemeState
@using ApexCharts

@if (Data != null && Data.Any() && Data.All(d => !string.IsNullOrEmpty(d.Label)))
{
    <div style="position: relative; width: 100%; max-width: 450px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 10px; font-size: 14px; color: var(--mud-palette-text-secondary);">
            @Title
        </div>
        <ApexChart TItem="PieChartData"
                   Title=""
                   Height="350"
                   Options="options">
            <ApexPointSeries TItem="PieChartData"
                             Items="Data"
                             Name="Count"
                             SeriesType="SeriesType.Donut"
                             XValue="@(e => e.Label)"
                             YAggregate="@(e => e.Sum(x => (decimal)x.Value))"
                             OrderBy="@(e => e.Y)" />
        </ApexChart>
    </div>
}
else if (Data != null && Data.Any())
{
    <div style="text-align: center; padding: 20px; color: var(--mud-palette-text-disabled);">
        Loading chart data...
    </div>
}

@code {
    [Parameter] public List<PieChartData>? Data { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Gender { get; set; } = "";

    private readonly string _chartId = $"pie-{Guid.NewGuid():N}";

    private ApexChartOptions<PieChartData> options => BuildOptions();

    private ApexChartOptions<PieChartData> BuildOptions()
    {
        var isDark = ThemeState.IsDarkMode;

        return new ApexChartOptions<PieChartData>
        {
            Chart = new ApexCharts.Chart
            {
                Id = _chartId,
                Type = ApexCharts.ChartType.Donut,
                ForeColor = isDark ? "#E0E0E0" : "#373D3F",
                Background = "transparent"
            },
            Theme = new ApexCharts.Theme
            {
                Mode = isDark ? ApexCharts.Mode.Dark : ApexCharts.Mode.Light
            },
            Legend = new Legend
            {
                Position = LegendPosition.Right
            },
            Colors = new List<string> { "#42A5F5", "#FF7043", "#66BB6A", "#FFA726", "#EC407A" },
            PlotOptions = new PlotOptions
            {
                Pie = new PlotOptionsPie
                {
                    Donut = new PlotOptionsDonut
                    {
                        Size = "70%"
                    }
                }
            },
            DataLabels = new DataLabels
            {
                Enabled = true
            },
            Tooltip = new Tooltip
            {
                Theme = isDark ? ApexCharts.Mode.Dark : ApexCharts.Mode.Light
            }
        };
    }
}